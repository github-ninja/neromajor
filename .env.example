# --- Required ---
TELEGRAM_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
DB_URL=postgresql://user:password@neuromajor_db:5432/neuromajor_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# --- Gemini (sampling parameters are intentionally not supported) ---
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SEARCH_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=low        # minimal | low | medium | high; unset = model default
# GEMINI_RPM=10                    # client-side requests-per-minute cap
# GEMINI_TIMEOUT=90
# GEMINI_RETRIES=4

# --- Background audit ---
# AUDIT_INTERVAL=360               # minutes between passes
# AUDIT_DAILY_REQUESTS=40          # Gemini requests the auditor may spend per day
# AUDIT_STATS_REQUESTS=3           # extra requests /stats may spend to catch up
# AUDIT_BATCH_MESSAGES=400
# AUDIT_BATCH_CHARS=30000

# --- Schedule (local time in BOT_TIMEZONE) ---
# BOT_TIMEZONE=Europe/Moscow
# ACTIVE_HOUR_START=9
# ACTIVE_HOUR_END=22
# SCHEDULER_REACT_PROBABILITY=0.15
# SCHEDULER_COOLDOWN=30            # minutes since the bot last spoke
# SCHEDULER_ACTIVITY_WINDOW=10     # minutes
# SCHEDULER_ACTIVITY_MIN_MESSAGES=5
# SCHEDULER_INACTIVE_HOURS=24

# --- Commands ---
# SUMMARY_DEFAULT_MESSAGES=100
# SUMMARY_MAX_MESSAGES=200
# PROFILE_MAX_MESSAGES=500
# MENTION_CONTEXT_MESSAGES=20
# MENTION_COOLDOWN=10              # seconds between replies to the same user

# DB_POOL_MIN=1
# DB_POOL_MAX=10
